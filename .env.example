# DeepSeek uses the OpenAI-compatible Chat Completions wire API.
# Never commit a real key.
DEEPSEEK_API_KEY=replace-me

# These defaults are shown explicitly so the first real run is reproducible.
CODING_AGENT_MODEL=deepseek-v4-flash
CODING_AGENT_BASE_URL=https://api.deepseek.com

# Optional private Session location. It must stay outside every workspace.
# CODING_AGENT_SESSION_ROOT=/absolute/path/to/private/sessions
